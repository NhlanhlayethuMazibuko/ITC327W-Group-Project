@model RoomListViewModel
@{
    ViewData["Title"] = "Browse rooms";
}

<section class="section container">
    <h1 class="list-title">Browse rooms</h1>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-warning">@message</div>
    }

    <form method="get" asp-controller="Rooms" asp-action="Index">
        <div class="search-row">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@Model.Search" placeholder="Search by type of room" />
            </div>
            <button type="submit" class="btn btn-orange">Filters</button>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <select name="price" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedPrice))">Any price</option>
                    <option value="low" selected="@(Model.SelectedPrice == "low")">Under R4 500</option>
                    <option value="mid" selected="@(Model.SelectedPrice == "mid")">R4 500 - R6 000</option>
                    <option value="high" selected="@(Model.SelectedPrice == "high")">Over R6 000</option>
                </select>
            </div>
            <div class="col-md-6">
                <select name="roomType" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedType))">Room type: All</option>
                    @foreach (var type in Model.RoomTypes)
                    {
                        <option value="@type" selected="@(Model.SelectedType == type)">@type</option>
                    }
                </select>
            </div>
        </div>
    </form>

    <p class="small-text mt-4">Showing @Model.Rooms.Count available room@(Model.Rooms.Count == 1 ? "" : "s"):</p>

    @if (Model.Rooms.Any())
    {
        <div class="browse-grid">
            @foreach (var card in Model.Rooms)
            {
                <partial name="_RoomCard" model="card" />
            }
        </div>
    }
    else
    {
        <div class="empty-box">
            <i class="bi bi-house-x"></i>
            <p>No rooms match your search. Try something different or clear the filters.</p>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-orange">Clear filters</a>
        </div>
    }
</section>