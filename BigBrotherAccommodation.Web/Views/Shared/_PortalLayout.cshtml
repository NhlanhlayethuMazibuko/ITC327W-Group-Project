@{
    var active = ViewData["Active"] as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Big Brother Student Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <div class="portal">
        <aside class="portal-side">
            <a class="portal-logo" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Big Brother Student Accommodations" />
            </a>

            <nav class="portal-nav">
                <a asp-controller="Student" asp-action="Dashboard" class="@(active == "dashboard" ? "active" : "")"><i class="bi bi-grid"></i> Dashboard</a>
                <a asp-controller="Student" asp-action="Rooms" class="@(active == "rooms" ? "active" : "")"><i class="bi bi-search"></i> Browse Rooms</a>
                <a asp-controller="Application" asp-action="Mine" class="@(active == "applications" ? "active" : "")"><i class="bi bi-question-circle"></i> My Applications</a>
                <a asp-controller="Viewing" asp-action="Mine" class="@(active == "viewings" ? "active" : "")"><i class="bi bi-calendar-check"></i> My viewings</a>
                <a asp-controller="Notifications" asp-action="Index" class="@(active == "notifications" ? "active" : "")"><i class="bi bi-bell"></i> Notifications</a>
                <a asp-controller="Maintenance" asp-action="Index" class="@(active == "maintenance" ? "active" : "")"><i class="bi bi-gear"></i> Maintenance</a>
                <a asp-controller="Profile" asp-action="Index" class="@(active == "profile" ? "active" : "")"><i class="bi bi-person-fill"></i> Profile</a>
            </nav>

            <form asp-controller="Account" asp-action="LogOut" method="post" class="portal-signout">
                <button type="submit"><i class="bi bi-box-arrow-left"></i> Sign out</button>
            </form>
            <div class="portal-foot">STUDENT PORTAL</div>
        </aside>

        <main class="portal-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>