@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Choose a new password</h1>
    <p class="auth-sub">Enter the code from your email and a new password</p>

    @if (TempData["Message"] is string message)
    {
        <div class="auth-notice">@message</div>
    }

    <div asp-validation-summary="ModelOnly" class="auth-error"></div>
    <div id="link-error" class="auth-error" hidden></div>

    <form method="post" asp-controller="Account" asp-action="ResetPassword">
        <input type="hidden" asp-for="AccessToken" />

        <div id="code-fields">
            <div class="auth-field">
                <label asp-for="Email">Email address</label>
                <div class="auth-input">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" />
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="Code">Reset code</label>
                <div class="auth-input">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" placeholder="Code from the email" />
                </div>
            </div>
        </div>

        <div class="auth-field">
            <label asp-for="Password">New password</label>
            <div class="auth-input">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" type="password" placeholder="Create a new password" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Password"></span>
        </div>

        <div class="auth-field">
            <label asp-for="ConfirmPassword">Confirm password</label>
            <div class="auth-input">
                <i class="bi bi-lock"></i>
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm your new password" autocomplete="new-password" />
            </div>
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-orange w-100 mt-2">Update password</button>
    </form>

    <p class="auth-switch">No code, or it expired? <a asp-controller="Account" asp-action="ForgotPassword">Send a new one</a></p>
</div>

<script>
    // An older emailed link puts the session in the URL fragment; then no code is needed
    (function () {
        var params = new URLSearchParams(location.hash.substring(1));
        var token = params.get("access_token");
        var field = document.getElementById("AccessToken");

        if (token) {
            field.value = token;
            history.replaceState(null, "", location.pathname);
        }
        if (field.value) {
            document.getElementById("code-fields").hidden = true;
        } else if (params.get("error_description")) {
            var box = document.getElementById("link-error");
            box.textContent = params.get("error_description").replace(/\+/g, " ") + ". Request a new code.";
            box.hidden = false;
        }
    })();
</script>
