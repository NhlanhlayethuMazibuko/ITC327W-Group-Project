@model SignInViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Welcome back!</h1>
    <p class="auth-sub">Sign in to your account</p>

    @if (TempData["Message"] is string message)
    {
        <div class="auth-notice">@message</div>
    }

    <div asp-validation-summary="ModelOnly" class="auth-error"></div>

    <form method="post" asp-controller="Account" asp-action="SignIn">
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="auth-field">
            <label asp-for="Email">Email address</label>
            <div class="auth-input">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" />
            </div>
            <span asp-validation-for="Email"></span>
        </div>

        <div class="auth-field">
            <label asp-for="Password">Password</label>
            <div class="auth-input">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Password"></span>
        </div>

        <div class="auth-remember">
            <label class="form-check-label">
                <input asp-for="RememberMe" class="form-check-input" /> Remember me
            </label>
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-orange w-100">Sign In</button>
    </form>

    <p class="auth-or">Or continue with</p>
    <div class="auth-social">
        <button type="button" disabled title="Coming soon"><i class="bi bi-google" style="color:#DB4437"></i> Google</button>
        <button type="button" disabled title="Coming soon"><i class="bi bi-facebook" style="color:#1877F2"></i> Facebook</button>
    </div>

    <p class="auth-switch">Don't have an account? <a asp-controller="Account" asp-action="SignUp">Sign Up</a></p>
</div>