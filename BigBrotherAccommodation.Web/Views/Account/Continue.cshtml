@{
    ViewData["Title"] = "Create an account to continue";
}

<section class="section container">
    <div class="gate-card">
        <div class="gate-icon gate-icon-error"><i class="bi bi-x-lg"></i></div>
        <h1>Create an account to continue</h1>
        <p>Sign in or create a student account to book a viewing or apply for a room</p>
        <a href="#" class="btn btn-orange w-100 mb-3">Create account</a>
        <a href="#" class="btn btn-outline-orange w-100">I already have an account - Sign in</a>
        <p class="gate-note">You can browse rooms without an account. An account is needed to apply or book a viewing.</p>
    </div>
</section>