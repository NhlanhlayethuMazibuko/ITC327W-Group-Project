@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1>Let's get you back in</h1>
    <p class="auth-sub">Enter your email and we'll send a reset link</p>

    @if (Model.Sent)
    {
        <div class="auth-notice">If an account exists for that email, we've sent a reset link. Check your inbox.</div>
    }

    <form method="post" asp-controller="Account" asp-action="ForgotPassword">
        <div class="auth-field">
            <div class="auth-input">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" />
            </div>
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="btn btn-orange w-100 mt-2">Send reset link</button>
    </form>

    <p class="auth-switch">Remember your password? <a asp-controller="Account" asp-action="SignIn">Sign in</a></p>
</div>