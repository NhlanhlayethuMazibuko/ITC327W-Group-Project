@model ViewingRecord
@{
    ViewData["Title"] = "Request submitted";
    ViewData["Active"] = "viewings";
    Layout = "_PortalLayout";
}

<div class="ap-done">
    <div class="ap-check"><i class="bi bi-check-lg"></i></div>
    <h1>Request submitted</h1>

    <p class="ap-left">Your viewing request has been sent!</p>
    <div class="ap-ref">
        <small>Viewing request @Model.Reference Submitted @Model.CreatedAt.ToLocalTime().ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</small>
        <strong>@Model.Reference</strong>
        <small>Keep this reference for your records.</small>
    </div>
    <p class="ap-left">You can check updates in your student portal.</p>

    <a asp-controller="Viewing" asp-action="Mine" class="ap-btn ap-narrow">View my viewings</a>
    <a asp-controller="Student" asp-action="Dashboard" class="ap-btn-soft ap-narrow">Return to dashboard</a>
</div>